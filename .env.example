# API local (SQLite)
SPRING_PROFILES_ACTIVE=local
MINDSAGE_DATABASE_URL=jdbc:sqlite:./data/mindsage.db
MINDSAGE_ALLOWED_ORIGINS=http://localhost:4200

# Producción (PostgreSQL): define estos valores en el gestor de secretos,
# nunca en el repositorio.
# SPRING_PROFILES_ACTIVE=production
# MINDSAGE_DATABASE_URL=jdbc:postgresql://localhost:5432/mindsage
# MINDSAGE_DATABASE_USERNAME=mindsage
# MINDSAGE_DATABASE_PASSWORD=change-me
# MINDSAGE_ALLOWED_ORIGINS=https://example.org

